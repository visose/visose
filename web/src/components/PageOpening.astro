---
import PlanarField from "./PlanarField.astro";

interface Props {
  heading: string;
  compact?: boolean;
}
const { heading, compact = false } = Astro.props;
const hasIntro = Astro.slots.has("default");
---

<section class="page-opening py-8 sm:py-10 lg:py-12 xl:py-14">
  <PlanarField variant="header" />
  <div
    class:list={[
      "wrap grid gap-5 sm:gap-7",
      {
        "max-w-195": compact,
        "lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:items-start lg:gap-12 xl:gap-16":
          !compact && hasIntro,
      },
    ]}
  >
    <h1 class="min-w-0 max-w-250 text-pretty">
      <slot name="heading">{heading}</slot>
    </h1>
    {hasIntro && (
      <div
        class:list={[
          "prose min-w-0 text-muted",
          compact
            ? "max-w-195 text-base sm:text-body"
            : "max-w-[62ch] text-lg sm:text-xl lg:pt-1",
        ]}
      >
        <slot />
      </div>
    )}
  </div>
</section>
