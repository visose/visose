---
interface Props {
  title: string;
  caption: string;
}
const { title, caption } = Astro.props;
const compact = Astro.slots.has("compact");
---

<figure class="project-diagram m-0" data-diagram>
  <figcaption>{caption}</figcaption>
  <div class="architecture">
    <p class="architecture-title">{title}</p>
    <div class:list={[{ "wide-layout": compact }]}>
      <slot />
    </div>
    {compact && (
      <div class="narrow-layout">
        <slot name="compact" />
      </div>
    )}
  </div>
</figure>
<style>
  .project-diagram {
    container-type: inline-size;
  }
  .narrow-layout {
    display: none;
  }
  .architecture {
    --connector: #68747c;
    --connection-gap: 16px;
    --node-gap: 20px;
    padding: 16px;
    border: 1px solid var(--color-line-strong);
    background: var(--color-silver);
  }
  .architecture-title {
    margin: 0 0 16px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
  }
  .architecture :global(.diagram-stack) {
    display: grid;
    gap: var(--connection-gap);
  }
  .architecture :global(.node-row) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--node-gap);
  }
  .architecture :global(.above-core > .architecture-node::after),
  .architecture :global(.below-core > .architecture-node::before) {
    content: "";
    position: absolute;
    width: 1px;
    height: var(--connection-gap);
    background: var(--connector);
    left: 50%;
  }
  .architecture :global(.above-core > .architecture-node::after) {
    top: 100%;
  }
  .architecture :global(.below-core > .architecture-node::before) {
    bottom: 100%;
  }
  .architecture :global(.emphasis ul) {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px 20px;
  }
  .architecture :global(.emphasis li) {
    margin: 0;
  }
  @container (width < 760px) {
    .wide-layout {
      display: none;
    }
    .narrow-layout {
      display: block;
    }
    .architecture {
      padding: 12px;
      --node-gap: 12px;
    }
    .architecture :global(.node-row) {
      grid-template-columns: 1fr;
      gap: 8px;
      border-inline-start: 1px solid var(--connector);
      padding-inline-start: 12px;
    }
    .architecture :global(.node-row > .architecture-node)::after {
      display: none;
    }
    .architecture :global(.node-row > .architecture-node)::before {
      content: "";
      position: absolute;
      width: 12px;
      height: 1px;
      background: var(--connector);
      left: -13px;
      top: 50%;
      bottom: auto;
    }
    .architecture :global(.emphasis ul) {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
      gap: 2px 12px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .is-diagram-active
      .architecture
      :global(.above-core > .architecture-node::after),
    .is-diagram-active
      .architecture
      :global(.below-core > .architecture-node::before) {
      transform-origin: top;
      animation: connect-node 650ms var(--ease-out) both;
    }
    .is-diagram-active
      .architecture
      :global(.below-core > .architecture-node::before) {
      animation-delay: 200ms;
    }
  }
  @keyframes connect-node {
    from {
      transform: scaleY(0);
      opacity: 0.4;
    }
    to {
      transform: scaleY(1);
      opacity: 1;
    }
  }
  figcaption {
    margin-bottom: 14px;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    max-width: 70ch;
  }
</style>
