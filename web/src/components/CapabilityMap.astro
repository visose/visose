---
import { ArrowUpRight } from "@lucide/astro";
import type { Section } from "../lib/website";
interface Props {
  entries: (Section & { href: string })[];
}
const { entries } = Astro.props;
---

<div class="capability-map">
  {entries.map((entry, index) => (
    <section
      class:list={["capability-node", { "capability-core": index === 0 }]}
      id={entry.id}
    >
      <h3>
        <a href={entry.href}>
          {entry.heading}
          <ArrowUpRight size={16} stroke-width={1.4} aria-hidden="true" />
        </a>
      </h3>
      <div class="capability-copy" set:html={entry.html} />
    </section>
  ))}
</div>
<style>
  .capability-map {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr;
    gap: 28px 36px;
    padding-block: 16px;
  }
  .capability-node {
    border-top: 1px solid var(--color-line-strong);
    padding-top: 18px;
  }
  .capability-core {
    grid-row: span 2;
    padding-right: 24px;
  }
  h3 {
    font-size: 19px;
    line-height: 1.3;
  }
  .capability-core h3 {
    font-size: 25px;
  }
  h3 a {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  h3 svg {
    flex: none;
    transition: transform 220ms var(--ease-out);
  }
  h3 a:hover svg,
  h3 a:focus-visible svg {
    transform: translate(2px, -2px);
  }
  .capability-copy {
    margin-top: 6px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-muted);
  }
  @media (width < 56.25rem) {
    .capability-map {
      grid-template-columns: 1fr 1fr;
      gap: 24px 32px;
    }
    .capability-core {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .capability-core .capability-copy {
      max-width: 60ch;
    }
  }
  @media (width < 37.5rem) {
    .capability-map {
      grid-template-columns: 1fr;
    }
  }
</style>
