---
interface Props {
  variant?: "hero" | "header" | "footer";
}
const { variant = "hero" } = Astro.props;
const footer = variant === "footer";
---

<div
  class:list={["planar-field forced-colors:hidden", variant]}
  aria-hidden="true"
>
  <svg
    class="hidden size-full sm:block"
    viewBox="0 0 1440 760"
    preserveAspectRatio="none"
    focusable="false"
  >
    {!footer && (
      <>
        <defs>
          <linearGradient id="plane-ground" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#dadde0" />
            <stop offset=".54" stop-color="#f5f5f3" />
            <stop offset="1" stop-color="#e1e4e5" />
          </linearGradient>
        </defs>
        <rect width="1440" height="760" fill="url(#plane-ground)" />
      </>
    )}
    <polygon
      class="plane-cap"
      points={
        footer ? "1010,-90 1530,80 1530,-90" : "555,-80 1700,284.05 1700,-80"
      }
      fill="#fff"
      fill-opacity=".84"
    />
    <polygon
      class="plane-face"
      points={
        footer
          ? "1010,-90 1530,80 1530,680 1270,580"
          : "555,-80 1700,284.05 1640,632.02 826,452"
      }
      fill="#8a929b"
      fill-opacity=".09"
    />
    <polygon
      class="plane-base"
      points={
        footer
          ? "-90,700 1530,120 1530,840 -90,840"
          : "-90,744 1660,267.61 1660,900 -90,900"
      }
      fill="#b4bbc0"
      fill-opacity=".22"
    />
    <polygon
      class="plane-fold"
      points={
        footer ? "-90,700 335,548 260,840 -90,840" : "-90,744 826,452 980,760"
      }
      fill="#fff"
      fill-opacity=".53"
    />
    <path
      class="plane-seam"
      d={footer ? "M-90 700 1530 120" : "M-90 744 1660 267.61"}
      stroke="#fff"
      stroke-opacity=".9"
      stroke-width="2"
    />
  </svg>
  <svg
    class="block size-full sm:hidden"
    viewBox="0 0 390 600"
    preserveAspectRatio="none"
    focusable="false"
  >
    {!footer && <rect width="390" height="600" fill="#e9ebec" />}
    <polygon
      class="plane-cap"
      points="232,-30 430,42 430,442 318,406"
      fill="#fff"
      fill-opacity=".84"
    />
    <polygon
      class="plane-base"
      points="-40,566 430,386 430,650 -40,650"
      fill="#b4bbc0"
      fill-opacity=".22"
    />
    <path
      class="plane-seam"
      d="M-40 566 430 386"
      stroke="#fff"
      stroke-opacity=".9"
      stroke-width="1"
    />
  </svg>
</div>

<style>
  .planar-field {
    position: absolute;
    inset: calc(-1 * var(--site-header-height)) 0 0;
    z-index: -1;
    overflow: hidden;
    background-color: var(--color-silver);
    pointer-events: none;
  }

  .header svg {
    opacity: 0.68;
  }

  .footer {
    inset: auto 0 0;
    height: 700px;
    background-color: var(--color-graphite);
  }
  .footer .plane-cap {
    fill: #3a4148;
    fill-opacity: 0.72;
  }
  .footer .plane-face {
    fill: #657480;
    fill-opacity: 0.2;
  }
  .footer .plane-base {
    fill: #8b98a5;
    fill-opacity: 0.12;
  }
  .footer .plane-fold {
    fill: #9caab6;
    fill-opacity: 0.1;
  }
  .footer .plane-seam {
    stroke: #9caab6;
    stroke-opacity: 0.12;
  }

  @media (width < 37.5rem) {
    .footer {
      height: 860px;
    }
  }
</style>
