---
import analyticsCopy from "../content/analytics.json";
import PlanarField from "./PlanarField.astro";

interface Props {
  home: boolean;
}
const { home } = Astro.props;
const linkClass =
  "inline-flex min-h-11 items-center py-2 no-underline hover:underline";
---

<footer class="on-dark relative isolate shrink-0 overflow-hidden bg-graphite text-[#e8eaeb]">
  {home && <PlanarField variant="footer" />}
  <slot />
  <div class="wrap flex flex-col gap-3 py-6 text-sm sm:py-7 xl:flex-row xl:items-center xl:gap-x-6">
    <div class="flex items-center justify-between gap-5 xl:contents">
      <a
        class="mr-auto inline-flex min-h-11 items-center"
        href="/"
        aria-label="visose home"
      >
        <img
          class="h-auto w-27.5 invert forced-colors:filter-none"
          src="/brand/visose.svg"
          alt="visose"
          width="128"
          height="36"
        />
      </a>
      <small class="text-xs whitespace-nowrap text-[#c1c6ca] xl:order-last">
        © {new Date().getFullYear()} VISOSE LTD
      </small>
    </div>
    <nav class="flex flex-wrap items-center gap-x-6" aria-label="Footer">
      <div class="flex flex-wrap items-center gap-x-5">
        <a class={linkClass} href="mailto:info@visose.com">
          info@visose.com
        </a>
        <a class={linkClass} href="https://github.com/visose">
          GitHub
        </a>
        <a class={linkClass} href="https://www.linkedin.com/company/visose/">
          LinkedIn
        </a>
      </div>
      <div class="flex flex-wrap items-center gap-x-5">
        <a class:list={[linkClass, "basis-full sm:basis-auto"]} href="/company">
          Company information
        </a>
        <a class={linkClass} href="/privacy">
          Privacy
        </a>
        <a class={linkClass} id="analytics-settings" href="/privacy#analytics">
          {analyticsCopy.settings}
        </a>
      </div>
    </nav>
  </div>
</footer>
