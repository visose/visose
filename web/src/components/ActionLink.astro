---
import { ArrowRight } from "@lucide/astro";
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a
  class="group inline-flex min-h-13.5 items-center justify-between gap-8 border border-graphite bg-graphite px-5.5 py-3.75 text-base text-white no-underline transition-colors duration-200 hover:bg-ink active:bg-focus forced-colors:border-[ButtonText]"
  href={href}
>
  <slot />
  <ArrowRight
    class="transition-transform duration-220 ease-out group-hover:translate-x-1 group-focus-visible:translate-x-1 group-active:translate-x-0"
    size={20}
    stroke-width={1.4}
    aria-hidden="true"
  />
</a>
