---
// Establish Tailwind's layer order before loading scoped component styles.
import "../styles/global.css";
import fontStyles from "../styles/fonts.css?inline";
import { createHash } from "node:crypto";
import SiteHeader, { initializeMenuHash } from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PlanarField from "../components/PlanarField.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import { isRelease } from "../lib/build";
import readingFont from "@fontsource-variable/dm-sans/files/dm-sans-latin-standard-normal.woff2?url";
Astro.csp?.insertScriptHash(initializeMenuHash);
Astro.csp?.insertStyleHash(
  `sha256-${createHash("sha256").update(fontStyles).digest("base64")}`,
);

interface Props {
  title: string;
  description: string;
  home?: boolean;
}
const { title, description, home = false } = Astro.props;
const notFound =
  Astro.url.pathname === "/404" || Astro.url.pathname === "/404.html";
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL("/brand/visose-share.png", Astro.site);
const shareDescription =
  "visose: software for design and engineering. Custom applications, CAD plugins and robotics.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://visose.com/#organization",
      name: "visose",
      legalName: "VISOSE LTD",
      url: "https://visose.com/",
      logo: "https://visose.com/brand/visose-square.png",
      email: "info@visose.com",
      sameAs: ["https://www.linkedin.com/company/86311461/"],
    },
    {
      "@type": "WebSite",
      "@id": "https://visose.com/#website",
      url: "https://visose.com/",
      name: "visose",
      publisher: { "@id": "https://visose.com/#organization" },
      inLanguage: "en",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {(!isRelease || notFound) && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#e9ebec" />
    {!isRelease && <meta name="visose-build" content="local-review" />}
    {isRelease && !notFound && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    {isRelease && !notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="visose" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareDescription} />
    {home && (
      <meta name="msvalidate.01" content="BC051F0BECB49715BAB8EFEDB02DE2A5" />
    )}
    {home && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
      />
    )}
    <title>{title}</title>
    <link
      rel="preload"
      href={readingFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Keep the font face stable when development stylesheets are replaced. -->
    <style is:inline set:html={fontStyles} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body
    class:list={[
      "flex min-h-svh flex-col text-base sm:text-lg",
      { "relative isolate bg-graphite": home },
    ]}
  >
    {home && <PlanarField variant="fragment" />}
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main
      id="main"
      class="relative w-full flex-[1_0_auto] focus:outline-none"
      tabindex="-1"
    >
      <slot />
    </main>
    <SiteFooter home={home} />
    <AnalyticsConsent />
  </body>
</html>
