---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { page, section } from "../lib/pages";
const content = page("contact");
const opening = content.opening;
const privacyNote = section(content, "privacy-note");
---

<BaseLayout
  title={content.title}
  description={content.description}
  openingSurface={false}
>
  <section
    class="wrap grid gap-7 py-10 sm:gap-9 sm:py-13 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.65fr)] lg:items-start lg:gap-13 lg:py-16 xl:gap-18"
    aria-labelledby="contact-heading"
  >
    <header>
      <h1 id="contact-heading" class="mb-4 sm:mb-5">
        {opening.heading}
      </h1>
      <div
        class="prose max-w-[32ch] text-lg text-pretty text-muted lg:text-xl"
        set:html={opening.html}
      />
    </header>
    <div class="min-w-0 border-t border-line pt-7 lg:border-t-0 lg:pt-0">
      <ContactForm />
      <div
        class="prose mt-7 text-caption text-muted"
        set:html={privacyNote.html}
      />
    </div>
  </section>
</BaseLayout>
