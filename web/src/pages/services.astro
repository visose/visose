---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageOpening from "../components/PageOpening.astro";
import { groupLinkLists, page, section } from "../lib/pages";

const services = page("services");
const opening = services.opening;
const development = section(services, "software-development");
const consulting = section(services, "technical-assessment");
const maintenance = section(services, "maintenance-and-support");
const working = section(services, "project-requirements");
const fees = section(services, "fees-and-scope");
---

<BaseLayout title={services.title} description={services.description}>
  <PageOpening heading={opening.heading}>
    <Fragment set:html={groupLinkLists(opening.html)} />
  </PageOpening>
  <section
    class="wrap grid gap-6 py-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1.9fr)] md:gap-12 md:py-16 xl:gap-16"
    id={development.id}
  >
    <div>
      <h2>{development.heading}</h2>
      <a
        class="mt-4 inline-flex min-h-11 items-center text-base"
        href={"#" + working.id}
      >
        {working.heading}
      </a>
    </div>
    <div
      id="continuing-development"
      class="prose development-copy max-w-[68ch] text-base sm:text-lg"
      set:html={development.html}
    />
  </section>
  <div class="border-t border-line bg-silver">
    <div class="wrap grid gap-9 py-11 md:grid-cols-2 md:gap-10 md:py-15 xl:gap-16">
      {[consulting, maintenance].map((entry) => (
        <section class="min-w-0 border-t border-line-strong pt-5" id={entry.id}>
          <h2 class="mb-5">{entry.heading}</h2>
          <div
            class="prose max-w-[62ch] text-base sm:text-lg"
            set:html={entry.html}
          />
        </section>
      ))}
    </div>
  </div>
  <section
    class="on-dark service-process scroll-mt-7 py-11 focus:outline-none md:py-16"
    id={working.id}
    tabindex="-1"
    data-diagram
  >
    <div class="wrap">
      <h2 class="mb-5">{working.heading}</h2>
      <div class="prose text-base md:text-body" set:html={working.html} />
    </div>
  </section>
  <section
    class="wrap scroll-mt-7 py-11 focus:outline-none md:grid md:grid-cols-[1fr_1.9fr] md:gap-[8%] md:py-15"
    id={fees.id}
    tabindex="-1"
  >
    <h2 class="mb-5 text-[25px]">{fees.heading}</h2>
    <div class="prose max-w-[68ch] text-base" set:html={fees.html} />
  </section>
</BaseLayout>

<style>
  @layer components {
    .development-copy :global(ul) {
      list-style: none;
      margin-block: 18px 0;
      padding: 0;
    }
    .development-copy :global(li) {
      padding: 0;
      margin: 0;
    }
    .development-copy :global(li a) {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-block: 6px;
    }
    #fees-and-scope .prose :global(p:last-child) {
      color: var(--color-muted);
      font-size: 14px;
    }
    .service-process .prose > :global(p:first-child) {
      max-width: 65ch;
    }
    .service-process .prose :global(ol) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 48px;
      margin: 40px 0 32px;
      padding-left: 28px;
    }
    .service-process .prose :global(li) {
      position: relative;
      margin: 0;
      padding: 12px 0 0 8px;
    }
    .service-process .prose :global(li::marker) {
      color: var(--color-muted);
      font-size: 14px;
      font-variant-numeric: tabular-nums;
    }
    .service-process .prose :global(li::after) {
      content: "";
      position: absolute;
      left: 8px;
      top: -10px;
      width: calc(100% + 48px);
      height: 1px;
      background: var(--color-line-strong);
    }
    .service-process .prose :global(li:last-child::after) {
      width: calc(100% - 8px);
    }
    .service-process .prose :global(li strong) {
      display: block;
      margin-bottom: 5px;
    }
    @media (prefers-reduced-motion: no-preference) {
      .service-process.is-diagram-active .prose :global(li::after) {
        transform-origin: left;
        animation: process-connect 750ms var(--ease-out) both;
      }
    }
    @keyframes process-connect {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
    @media (width < 43.75rem) {
      .service-process .prose :global(ol) {
        display: block;
        margin-top: 24px;
      }
      .service-process .prose :global(li) {
        padding-block: 0 28px;
      }
      .service-process .prose :global(li::after) {
        left: -18px;
        top: 29px;
        bottom: 7px;
        width: 1px;
        height: auto;
        animation: none;
      }
      .service-process .prose :global(li:last-child::after) {
        display: none;
      }
    }
  }
</style>
