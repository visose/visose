---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageOpening from "../components/PageOpening.astro";
import { groupLinkLists, page, section } from "../lib/pages";
const services = page("services");
const opening = services.opening;
const development = section(services, "software-development");
const consulting = section(services, "technical-assessment");
const maintenance = section(services, "maintenance-and-support");
const working = section(services, "project-requirements");
const fees = section(services, "fees-and-scope");
---

<BaseLayout title={services.title} description={services.description}>
  <PageOpening heading={opening.heading}>
    <Fragment set:html={groupLinkLists(opening.html)} />
  </PageOpening>
  <div class="wrap pt-10 pb-12 md:pt-12 md:pb-16">
    <a
      class="mb-7 inline-flex min-h-11 items-center text-base md:hidden"
      href={`#${working.id}`}
    >
      {working.heading}
    </a>
    <div class="service-main">
      {[development, consulting, maintenance].map((entry) => (
        <section class="service-area" id={entry.id}>
          <h2 class="mb-6 text-3xl xl:text-[34px]">{entry.heading}</h2>
          <div
            id={
              entry.id === development.id ? "continuing-development" : undefined
            }
            class="prose text-base md:text-body xl:text-lg"
            set:html={entry.html}
          />
        </section>
      ))}
    </div>
  </div>
  <section
    class="on-dark service-process scroll-mt-7 bg-graphite py-10 text-paper focus:outline-none md:py-14"
    id={working.id}
    tabindex="-1"
    data-diagram
  >
    <div class="wrap">
      <h2 class="mb-5 text-[29px] md:text-[34px]">{working.heading}</h2>
      <div class="prose text-base md:text-body" set:html={working.html} />
    </div>
  </section>
  <section
    class="wrap scroll-mt-7 py-10 focus:outline-none md:grid md:grid-cols-[1fr_1.9fr] md:gap-[8%] md:py-14"
    id={fees.id}
    tabindex="-1"
  >
    <h2 class="mb-5 text-[25px]">{fees.heading}</h2>
    <div class="prose max-w-[68ch] text-base" set:html={fees.html} />
  </section>
</BaseLayout>
<style>
  @layer components {
    .service-main {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .service-area {
      padding: 32px;
      background: var(--color-silver);
    }
    .service-area:first-child {
      grid-column: 1 / -1;
      padding: 0 0 16px;
      background: transparent;
    }
    .service-area:not(:first-child) {
      display: flex;
      flex-direction: column;
    }
    .service-area:not(:first-child) .prose {
      display: flex;
      flex: 1;
      flex-direction: column;
    }
    .service-area:not(:first-child) .prose :global(.prose-action:last-child) {
      margin-top: auto;
      padding-top: 20px;
    }
    .service-area:last-child {
      background: color-mix(
        in srgb,
        var(--color-silver) 55%,
        var(--color-paper)
      );
    }
    .service-area:first-child .prose {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 48px;
      max-width: none;
    }
    #fees-and-scope .prose :global(p:last-child) {
      color: var(--color-muted);
      font-size: 14px;
    }
    .service-main .prose :global(ul) {
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: 16px;
    }
    .service-main .prose :global(li a) {
      display: flex;
      align-items: center;
      min-height: 48px;
      padding-block: 10px;
      border-bottom: 1px solid var(--color-line);
    }
    .service-main .prose :global(li + li) {
      margin-top: 0;
    }
    .service-process .prose :global(ol) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 48px;
      margin: 40px 0 32px;
      padding-left: 28px;
    }
    .service-process .prose :global(li) {
      position: relative;
      margin: 0;
      padding: 12px 0 0 8px;
    }
    .service-process .prose :global(li::marker) {
      color: var(--color-silver);
      font-size: 14px;
      font-variant-numeric: tabular-nums;
    }
    .service-process .prose :global(li::after) {
      content: "";
      position: absolute;
      left: 8px;
      top: -10px;
      width: calc(100% + 48px);
      height: 1px;
      background: #8b949c;
    }
    .service-process .prose :global(li:last-child::after) {
      width: calc(100% - 8px);
    }
    .service-process .prose :global(li strong) {
      display: block;
      margin-bottom: 5px;
    }
    @media (prefers-reduced-motion: no-preference) {
      .service-process.is-diagram-active .prose :global(li::after) {
        transform-origin: left;
        animation: process-connect 750ms var(--ease-out) both;
      }
    }
    @keyframes process-connect {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
    @media (width < 43.75rem) {
      .service-main,
      .service-area:first-child .prose,
      .service-process .prose :global(ol) {
        display: block;
      }
      .service-area {
        margin-top: 24px;
        padding: 24px;
      }
      .service-area:first-child {
        margin-top: 0;
      }
      .service-main .prose :global(ul) {
        margin-top: 22px;
      }
      .service-process .prose :global(ol) {
        margin-top: 24px;
      }
      .service-process .prose :global(li) {
        padding-block: 0 28px;
      }
      .service-process .prose :global(li::after) {
        left: -18px;
        top: 29px;
        bottom: 7px;
        width: 1px;
        height: auto;
        animation: none;
      }
      .service-process .prose :global(li:last-child::after) {
        display: none;
      }
    }
  }
</style>
