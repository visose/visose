---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlanarField from "../components/PlanarField.astro";
import ActionLink from "../components/ActionLink.astro";
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import { page, projectGroups, section } from "../lib/pages";
const home = page("home");
const opening = home.opening;
const services = [
  ["applications", "/services/cad-and-3d-application-development"],
  ["plugins-and-integrations", "/services/cad-plugin-development"],
  ["robotics-software", "/services/robotics-software-development"],
] as const;
const more = section(home, "cad-and-robotics");
const starting = section(home, "working-with-visose");
const action = opening.action;
if (!action) throw new Error("Home needs a primary action.");
const selectedWork = [
  [
    "cad-and-3d-applications",
    [
      ["selected-applications", "/projects/architectural-cad-editor"],
      [
        "selected-coastal-engineering",
        "/projects#browser-cad-with-survey-data",
      ],
    ],
  ],
  [
    "plugins-and-data-processing",
    [
      ["selected-plugins", "/projects/bim-generation-for-housing-design"],
      [
        "selected-medical-brace-design",
        "/projects#medical-brace-design-in-rhino",
      ],
    ],
  ],
  [
    "robotics-and-fabrication",
    [
      ["selected-robotics", "/projects/robots"],
      [
        "selected-robotic-printing",
        "/projects#software-for-robotic-furniture-production",
      ],
      [
        "selected-robotic-milling",
        "/projects#cam-integration-for-six-axis-milling",
      ],
    ],
  ],
] as const;
---

<BaseLayout title={home.title} description={home.description} home>
  <section class="relative" aria-labelledby="home-title">
    <PlanarField />
    <div class="wrap hero-content relative">
      <h1 id="home-title">{opening.heading}</h1>
      <div class="hero-description prose" set:html={opening.html} />
      <div class="flex pt-8">
        <ActionLink href={action.href}>{action.label}</ActionLink>
      </div>
    </div>
  </section>
  <div class="bg-paper">
    <div class="wrap capability-spread py-10.5 sm:py-13.5 lg:grid lg:grid-cols-3 lg:gap-x-8 lg:gap-y-4 xl:gap-x-9">
      {services.map(([id, href]) => {
        const entry = section(home, id);
        return (
          <section
            class="home-capability mt-8 border-t border-line pt-7 first:mt-0 first:border-t-0 first:pt-0 lg:row-span-2 lg:mt-0 lg:grid lg:grid-rows-subgrid lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8 lg:first:border-l-0 lg:first:pl-0 xl:pl-9"
            aria-labelledby={entry.id}
          >
            <h2
              class="mb-3 text-2xl font-medium lg:mb-0 xl:text-[26px]"
              id={entry.id}
            >
              <a
                class="group inline-flex min-h-11 items-start gap-2 no-underline hover:underline"
                href={href}
              >
                <span>{entry.heading}</span>
                <ArrowUpRight
                  class="mt-1.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  size={18}
                  stroke-width={1.4}
                  aria-hidden="true"
                />
              </a>
            </h2>
            <div class="prose max-w-[61ch] text-base" set:html={entry.html} />
          </section>
        );
      })}
    </div>
  </div>
  <section class="bg-silver py-10.5 sm:py-13.5" aria-labelledby={more.id}>
    <div class="wrap">
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class="text-[29px] sm:text-[34px]" id={more.id}>
          {more.heading}
        </h2>
        <div class="prose text-base [&_p]:m-0" set:html={more.html} />
      </div>
      <div class="grid gap-8 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-5">
        {selectedWork.map(([groupId, projects]) => {
          const group = projectGroups.find((entry) => entry.id === groupId);
          if (!group)
            throw new Error(`Missing selected-work group: ${groupId}`);
          const headingId = `selected-group-${groupId}`;
          return (
            <section
              class="border-t border-line-strong pt-6 first:border-t-0 first:pt-0 lg:row-span-2 lg:grid lg:grid-rows-subgrid lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8 lg:first:border-l-0 lg:first:pl-0"
              aria-labelledby={headingId}
            >
              <h3
                class="mb-5 text-[22px] leading-[1.25] font-medium lg:mb-0"
                id={headingId}
              >
                {group.heading}
              </h3>
              <div class="grid content-start gap-6">
                {projects.map(([id, href]) => {
                  const entry = section(home, id);
                  return (
                    <a
                      class="group block min-h-11 no-underline"
                      href={href}
                      aria-labelledby={entry.id}
                    >
                      <h4
                        class="mb-1.5 flex items-start gap-2 text-lg leading-[1.3] font-medium xl:text-[19px]"
                        id={entry.id}
                      >
                        {entry.id === "selected-robotics" && (
                          <img
                            src="/brand/robots.svg"
                            width="24"
                            height="24"
                            alt=""
                            class="block size-6 shrink-0"
                          />
                        )}
                        <span class="min-w-0 decoration-1 underline-offset-5 group-hover:underline group-focus-visible:underline">
                          {entry.heading}
                        </span>
                        <ArrowUpRight
                          class="mt-1 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                          size={16}
                          stroke-width={1.4}
                          aria-hidden="true"
                        />
                      </h4>
                      <div class="prose text-base" set:html={entry.html} />
                    </a>
                  );
                })}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </section>
  <section
    class="on-dark relative py-8 text-paper sm:py-12"
    aria-labelledby={starting.id}
  >
    <div class="wrap relative sm:grid sm:grid-cols-[1.08fr_1fr] sm:gap-10 xl:gap-16">
      <h2 class="mb-5.5 text-[29px] sm:mb-0 sm:text-[34px]" id={starting.id}>
        {starting.heading}
      </h2>
      <div>
        <div class="prose max-w-[58ch] text-body" set:html={starting.html} />
        <a
          class="group mt-4 inline-flex min-h-11 items-center gap-3 text-body underline decoration-1 underline-offset-5"
          href={action.href}
        >
          {action.label}
          <ArrowRight
            class="transition-transform duration-200 group-hover:translate-x-1 group-focus-visible:translate-x-1"
            size={18}
            stroke-width={1.4}
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .hero-content {
    padding-block: 80px 88px;
  }
  .hero-content h1 {
    max-width: 1080px;
    font-size: 68px;
    line-height: 1.08;
    margin-bottom: 28px;
  }
  .hero-description {
    max-width: 850px;
    font-size: 21px;
    line-height: 1.5;
    color: var(--color-muted);
  }
  @media (width >= 56.25rem) and (max-height: 820px) {
    .capability-spread {
      padding-block: 54px;
    }
    .hero-content {
      padding-block: 66px 76px;
    }
    .hero-content h1 {
      font-size: 60px;
      max-width: 960px;
    }
  }
  @media (width < 62.5rem) {
    .hero-content h1 {
      font-size: 56px;
      max-width: 880px;
    }
    .hero-content {
      padding-block: 64px 84px;
    }
    .hero-description {
      font-size: 19px;
      max-width: 740px;
    }
  }
  @media (width < 37.5rem) {
    .hero-content {
      padding-block: 64px 68px;
    }
    .hero-content h1 {
      font-size: 38px;
      max-width: 490px;
      line-height: 1.12;
      margin-bottom: 26px;
      text-wrap: pretty;
    }
    .hero-description {
      font-size: 17px;
      max-width: 450px;
    }
  }
  @media (max-width: 350px) {
    .hero-content h1 {
      font-size: 34px;
    }
  }
</style>
