---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionLink from "../components/ActionLink.astro";
import PlanarField from "../components/PlanarField.astro";
import { ArrowRight, ArrowUpRight, Minus, Plus } from "@lucide/astro";
import { page, projectGroups, section } from "../lib/pages";

const home = page("home");
const opening = home.opening;
const action = opening.action;
if (!action) throw new Error("Home needs a primary action.");

const services = [
  ["applications", "/services/cad-and-3d-application-development"],
  ["plugins-and-integrations", "/services/cad-plugin-development"],
  ["robotics-software", "/services/robotics-software-development"],
] as const;
const more = section(home, "cad-and-robotics");
const featured = section(home, "selected-robotics");
const starting = section(home, "working-with-visose");
const selectedWork = [
  [
    "cad-and-3d-applications",
    [
      ["selected-applications", "/projects/architectural-cad-editor"],
      [
        "selected-coastal-engineering",
        "/projects#browser-cad-with-survey-data",
      ],
    ],
  ],
  [
    "plugins-and-data-processing",
    [
      ["selected-plugins", "/projects/bim-generation-for-housing-design"],
      [
        "selected-medical-brace-design",
        "/projects#medical-brace-design-in-rhino",
      ],
    ],
  ],
  [
    "robotics-and-fabrication",
    [
      [
        "selected-robotic-printing",
        "/projects#software-for-robotic-furniture-production",
      ],
      [
        "selected-robotic-milling",
        "/projects#cam-integration-for-six-axis-milling",
      ],
    ],
  ],
] as const;
---

<BaseLayout title={home.title} description={home.description} home>
  <section class="page-opening" aria-labelledby="home-title">
    <PlanarField />
    <div class="wrap grid gap-5 py-9 sm:gap-9 sm:py-14 lg:grid-cols-[minmax(0,1.85fr)_minmax(0,1fr)] lg:items-center lg:gap-12 lg:py-16 xl:gap-16 xl:py-18">
      <h1
        id="home-title"
        class="min-w-0 max-w-[17ch] text-pretty max-[22rem]:text-[2.125rem] lg:text-[clamp(3rem,4.7vw,4.25rem)] lg:text-balance"
      >
        {opening.heading}
      </h1>
      <div class="min-w-0 border-t border-line-strong pt-4 lg:border-t-0 lg:pt-0">
        <div
          class="prose max-w-[42ch] text-lg text-pretty text-muted lg:[&_p]:text-balance xl:text-xl"
          set:html={opening.html}
        />
        <div class="mt-5 flex sm:mt-6">
          <ActionLink href={action.href}>{action.label}</ActionLink>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap py-9 sm:py-13 lg:py-15" aria-labelledby="home-services">
    <h2 class="mb-4 sm:mb-6" id="home-services">
      {page("services").opening.heading}
    </h2>
    <div class="border-t border-line-strong">
      {services.map(([id, href]) => {
        const entry = section(home, id);
        return (
          <section aria-labelledby={id} class="border-b border-line-strong">
            <a
              class="service-link group grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-5 gap-y-1.5 py-4 no-underline sm:py-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.85fr)_auto] lg:gap-x-10"
              href={href}
              aria-labelledby={id}
            >
              <h3
                class="col-start-1 row-start-1 text-[22px] leading-[1.2] text-pretty sm:text-[25px]"
                id={id}
              >
                {entry.heading}
              </h3>
              <div
                class="prose col-span-full row-start-2 max-w-[65ch] text-base text-muted lg:col-[2/3] lg:row-start-1"
                set:html={entry.html}
              />
              <ArrowRight
                class="col-start-2 row-start-1 mt-1 text-muted transition-transform group-hover:translate-x-1 group-focus-visible:translate-x-1 lg:col-start-3"
                size={21}
                stroke-width={1.5}
                aria-hidden="true"
              />
            </a>
          </section>
        );
      })}
    </div>
  </section>

  <section
    class="border-y border-line bg-silver py-9 sm:py-13 lg:py-16"
    aria-labelledby={more.id}
  >
    <div class="wrap grid gap-6 sm:gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.55fr)] lg:gap-12 xl:gap-16">
      <div>
        <div class="flex flex-wrap items-baseline justify-between gap-x-3">
          <h2 id={more.id}>{more.heading}</h2>
          <div
            class="prose text-base [&_a]:inline-flex [&_a]:min-h-11 [&_a]:items-center"
            set:html={more.html}
          />
        </div>
        <a
          class="group mt-3 block border-t border-line-strong pt-4 no-underline sm:mt-5"
          href="/projects/robots"
          aria-labelledby={featured.id}
        >
          <h3 class="mb-2 flex items-center gap-2.5 text-2xl" id={featured.id}>
            <img
              src="/brand/robots.svg"
              width="28"
              height="28"
              alt=""
              class="size-7 shrink-0"
            />
            <span class="decoration-1 underline-offset-5 group-hover:underline group-focus-visible:underline">
              {featured.heading}
            </span>
            <ArrowUpRight
              class="shrink-0 text-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              size={18}
              stroke-width={1.5}
              aria-hidden="true"
            />
          </h3>
          <div
            class="prose max-w-[46ch] text-base text-muted"
            set:html={featured.html}
          />
        </a>
      </div>
      <div class="border-b border-line-strong lg:self-start">
        {selectedWork.map(([groupId, projects], index) => {
          const group = projectGroups.find((entry) => entry.id === groupId);
          if (!group)
            throw new Error("Missing selected-work group: " + groupId);
          return (
            <details
              class="group border-t border-line-strong"
              name="homepage-work"
              open={index === 0}
            >
              <summary
                class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 py-2.5 text-lg font-medium underline-offset-5 hover:underline"
                id={"selected-group-" + groupId}
              >
                <span>{group.heading}</span>
                <Plus
                  class="shrink-0 text-muted group-open:hidden"
                  size={18}
                  stroke-width={1.4}
                  aria-hidden="true"
                />
                <Minus
                  class="hidden shrink-0 text-muted group-open:block"
                  size={18}
                  stroke-width={1.4}
                  aria-hidden="true"
                />
              </summary>
              <ul class="m-0 list-none pb-4 pl-4 sm:pl-5">
                {projects.map(([id, href]) => {
                  const entry = section(home, id);
                  return (
                    <li>
                      <a
                        class="project-link block py-2.5 no-underline"
                        href={href}
                        aria-labelledby={id}
                      >
                        <h3
                          class="mb-1.5 flex items-start justify-between gap-3 text-lg leading-tight"
                          id={id}
                        >
                          <span class="project-title">{entry.heading}</span>
                          <ArrowUpRight
                            class="shrink-0 text-muted"
                            size={17}
                            stroke-width={1.4}
                            aria-hidden="true"
                          />
                        </h3>
                        <div
                          class="prose max-w-[61ch] text-base text-muted"
                          set:html={entry.html}
                        />
                      </a>
                    </li>
                  );
                })}
              </ul>
            </details>
          );
        })}
      </div>
    </div>
  </section>

  <section slot="closing" aria-labelledby={starting.id}>
    <div class="wrap py-9 sm:py-13 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.55fr)] lg:gap-12 xl:gap-16">
      <h2 class="mb-4 lg:mb-0" id={starting.id}>
        {starting.heading}
      </h2>
      <div>
        <div
          class="prose max-w-[61ch] text-body sm:text-lg"
          set:html={starting.html}
        />
        <a
          class="group mt-3 inline-flex min-h-11 items-center gap-3 text-base underline-offset-5"
          href={action.href}
        >
          {action.label}
          <ArrowRight
            class="transition-transform group-hover:translate-x-1 group-focus-visible:translate-x-1"
            size={18}
            stroke-width={1.4}
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-link:is(:hover, :focus-visible) h3,
  .project-link:is(:hover, :focus-visible) .project-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
</style>
