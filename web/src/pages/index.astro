---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlanarField from "../components/PlanarField.astro";
import ActionLink from "../components/ActionLink.astro";
import { groupLinkLists, page, section } from "../lib/pages";
const home = page("home");
const opening = home.opening;
const application = section(home, "applications");
const integrations = section(home, "plugins-and-integrations");
const more = section(home, "cad-and-robotics");
const starting = section(home, "working-with-visose");
const action = opening.action;
if (!action) throw new Error("Home needs a primary action.");
const selectedWork = [
  "selected-applications",
  "selected-plugins",
  "selected-robotics",
].map((id) => section(home, id));
---

<BaseLayout title={home.title} description={home.description} home>
  <section class="relative" aria-labelledby="home-title">
    <PlanarField />
    <div class="wrap hero-content relative">
      <h1 id="home-title">{opening.heading}</h1>
      <div class="hero-description prose" set:html={opening.html} />
      <p class="pt-8">
        <ActionLink href={action.href}>{action.label}</ActionLink>
      </p>
    </div>
  </section>
  <div class="bg-paper">
    <div class="wrap capability-spread py-10.5 sm:grid sm:grid-cols-[1.08fr_1fr] sm:py-13.5 xl:py-18">
      {[application, integrations].map((entry) => (
        <section
          class="home-capability first:pb-9 last:border-t last:border-line last:pt-9 sm:first:pr-8 sm:first:pb-0 sm:last:border-t-0 sm:last:border-l sm:last:pt-0 sm:last:pl-8 xl:first:pr-16 xl:last:pl-16"
          aria-labelledby={entry.id}
        >
          <h2
            class="mb-4 text-[29px] font-medium sm:mb-6.5 sm:font-normal xl:text-[34px]"
            id={entry.id}
          >
            {entry.heading}
          </h2>
          <div
            class="prose max-w-[61ch] text-base sm:text-body"
            set:html={entry.html}
          />
        </section>
      ))}
    </div>
  </div>
  <section class="bg-silver py-9 sm:pt-10.5 sm:pb-13" aria-labelledby={more.id}>
    <div class="wrap">
      <h2 class="mb-7.5 text-[28px] sm:text-3xl" id={more.id}>
        {more.heading}
      </h2>
      <div class="selected-work grid gap-7 xl:grid-cols-3 xl:gap-9">
        {selectedWork.map((entry) => (
          <section class="border-t border-line-strong pt-6 first:border-t-0 first:pt-0 xl:border-t-0 xl:border-l xl:pt-0 xl:pl-9 xl:first:border-l-0 xl:first:pl-0">
            <h3 class="mb-3 text-[22px] font-medium xl:text-xl" id={entry.id}>
              {entry.heading}
            </h3>
            <div class="prose text-base" set:html={entry.html} />
          </section>
        ))}
      </div>
      <div class="prose mt-7" set:html={more.html} />
    </div>
  </section>
  <section class="on-dark relative py-10 text-paper sm:py-16">
    <div class="wrap relative sm:grid sm:grid-cols-[1.08fr_1fr] sm:gap-10 xl:gap-16">
      <h2 class="mb-5.5 text-[29px] sm:mb-0 sm:text-[34px]">
        {starting.heading}
      </h2>
      <div
        class="prose max-w-[58ch] text-body"
        set:html={groupLinkLists(starting.html)}
      />
    </div>
  </section>
</BaseLayout>
<style>
  .hero-content {
    padding-block: 104px 118px;
  }
  .hero-content h1 {
    max-width: 1080px;
    font-size: 68px;
    line-height: 1.08;
    margin-bottom: 28px;
  }
  .hero-description {
    max-width: 850px;
    font-size: 21px;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .home-capability .prose :global(p:nth-child(2)) {
    margin-top: 32px;
  }
  .selected-work .prose :global(ul) {
    display: grid;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .selected-work .prose :global(li) {
    margin: 0;
    padding: 0;
  }
  .selected-work .prose :global(li a) {
    display: block;
    width: fit-content;
    margin-bottom: 2px;
    font-weight: 500;
  }
  .selected-work .prose :global(.prose-action) {
    margin-top: 16px;
  }
  .selected-work .prose :global(.prose-action a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @media (width >= 56.25rem) and (max-height: 820px) {
    .capability-spread {
      padding-block: 54px;
    }
    .hero-content {
      padding-block: 66px 76px;
    }
    .hero-content h1 {
      font-size: 60px;
      max-width: 960px;
    }
  }
  @media (width < 62.5rem) {
    .hero-content h1 {
      font-size: 56px;
      max-width: 880px;
    }
    .hero-content {
      padding-block: 64px 84px;
    }
    .hero-description {
      font-size: 19px;
      max-width: 740px;
    }
  }
  @media (width < 37.5rem) {
    .home-capability .prose :global(p:nth-child(2)) {
      margin-top: 18px;
    }
    .hero-content {
      padding-block: 64px 68px;
    }
    .hero-content h1 {
      font-size: 38px;
      max-width: 490px;
      line-height: 1.12;
      margin-bottom: 26px;
      text-wrap: pretty;
    }
    .hero-description {
      font-size: 17px;
      max-width: 450px;
    }
  }
  @media (max-width: 350px) {
    .hero-content h1 {
      font-size: 34px;
    }
  }
</style>
