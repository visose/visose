---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlanarField from "../components/PlanarField.astro";
import ActionLink from "../components/ActionLink.astro";
import { groupLinkLists, page, section } from "../lib/pages";
const home = page("home");
const opening = home.opening;
const application = section(home, "applications");
const integrations = section(home, "plugins-and-integrations");
const robotics = section(home, "robotics-software");
const more = section(home, "cad-and-robotics");
const starting = section(home, "working-with-visose");
const action = opening.action;
if (!action) throw new Error("Home needs a primary action.");
const selectedWork = [
  "selected-applications",
  "selected-plugins",
  "selected-robotics",
].map((id) => section(home, id));
---

<BaseLayout title={home.title} description={home.description} home>
  <section class="relative" aria-labelledby="home-title">
    <PlanarField />
    <div class="wrap hero-content relative">
      <h1 id="home-title">{opening.heading}</h1>
      <div class="hero-description prose" set:html={opening.html} />
      <div class="flex flex-wrap items-center gap-x-7 gap-y-4 pt-8 text-base sm:text-lg">
        <ActionLink href={action.href}>{action.label}</ActionLink>
        {opening.secondaryAction && (
          <a
            class="inline-flex min-h-11 items-center"
            href={opening.secondaryAction.href}
          >
            {opening.secondaryAction.label}
          </a>
        )}
      </div>
    </div>
  </section>
  <section class="bg-silver py-10.5 sm:py-13.5" aria-labelledby={more.id}>
    <div class="wrap">
      <h2 class="mb-8 text-[29px] sm:text-[34px]" id={more.id}>
        {more.heading}
      </h2>
      <div class="grid gap-8 lg:grid-cols-3 lg:gap-8 xl:gap-9">
        {selectedWork.map((entry) => (
          <section
            class="border-t border-line-strong pt-7 first:border-t-0 first:pt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8 lg:first:border-l-0 lg:first:pl-0 xl:pl-9"
            aria-labelledby={entry.id}
          >
            <h3
              class="mb-4 text-[25px] leading-[1.2] font-medium xl:text-[28px]"
              id={entry.id}
            >
              {entry.heading}
            </h3>
            <div class="prose text-base sm:text-body" set:html={entry.html} />
          </section>
        ))}
      </div>
      <div class="prose mt-7" set:html={more.html} />
    </div>
  </section>
  <div class="bg-paper">
    <div class="wrap capability-spread py-10.5 sm:py-13.5 lg:grid lg:grid-cols-3 lg:gap-8 xl:gap-9">
      {[application, integrations, robotics].map((entry) => (
        <section
          class="home-capability mt-9 border-t border-line pt-9 first:mt-0 first:border-t-0 first:pt-0 lg:mt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8 lg:first:border-l-0 lg:first:pl-0 xl:pl-9"
          aria-labelledby={entry.id}
        >
          <h2
            class="mb-4 text-[25px] font-medium sm:font-normal xl:text-[28px]"
            id={entry.id}
          >
            {entry.heading}
          </h2>
          <div class="prose max-w-[61ch] text-base" set:html={entry.html} />
        </section>
      ))}
    </div>
  </div>
  <section
    class="on-dark relative py-10 text-paper sm:py-16"
    aria-labelledby={starting.id}
  >
    <div class="wrap relative sm:grid sm:grid-cols-[1.08fr_1fr] sm:gap-10 xl:gap-16">
      <h2 class="mb-5.5 text-[29px] sm:mb-0 sm:text-[34px]" id={starting.id}>
        {starting.heading}
      </h2>
      <div
        class="prose max-w-[58ch] text-body"
        set:html={groupLinkLists(starting.html)}
      />
    </div>
  </section>
</BaseLayout>
<style>
  .hero-content {
    padding-block: 80px 88px;
  }
  .hero-content h1 {
    max-width: 1080px;
    font-size: 68px;
    line-height: 1.08;
    margin-bottom: 28px;
  }
  .hero-description {
    max-width: 850px;
    font-size: 21px;
    line-height: 1.5;
    color: var(--color-muted);
  }
  @media (width >= 56.25rem) and (max-height: 820px) {
    .capability-spread {
      padding-block: 54px;
    }
    .hero-content {
      padding-block: 66px 76px;
    }
    .hero-content h1 {
      font-size: 60px;
      max-width: 960px;
    }
  }
  @media (width < 62.5rem) {
    .hero-content h1 {
      font-size: 56px;
      max-width: 880px;
    }
    .hero-content {
      padding-block: 64px 84px;
    }
    .hero-description {
      font-size: 19px;
      max-width: 740px;
    }
  }
  @media (width < 37.5rem) {
    .hero-content {
      padding-block: 64px 68px;
    }
    .hero-content h1 {
      font-size: 38px;
      max-width: 490px;
      line-height: 1.12;
      margin-bottom: 26px;
      text-wrap: pretty;
    }
    .hero-description {
      font-size: 17px;
      max-width: 450px;
    }
  }
  @media (max-width: 350px) {
    .hero-content h1 {
      font-size: 34px;
    }
  }
</style>
