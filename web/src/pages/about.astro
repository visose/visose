---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageOpening from "../components/PageOpening.astro";
import CapabilityMap from "../components/CapabilityMap.astro";
import { groupLinkLists, page, section } from "../lib/pages";
const about = page("about");
const opening = about.opening;
const company = section(about, "company-information");
const background = section(about, "founder");
const expertise = section(about, "technical-expertise");
const openSource = section(about, "open-source-software");
const expertiseLinks = section(about, "expertise-links");
const capabilities = [
  ["expertise-software", "/services"],
  ["expertise-geometry", "/services/cad-and-3d-application-development"],
  ["expertise-integrations", "/services/cad-plugin-development"],
  ["expertise-robotics", "/services/robotics-software-development"],
  ["expertise-delivery", "/services#maintenance-and-support"],
] as const;
---

<BaseLayout title={about.title} description={about.description}>
  <PageOpening heading={opening.heading}>
    <Fragment set:html={groupLinkLists(opening.html)} />
  </PageOpening>
  <section class="on-dark py-12 md:py-17" id={background.id}>
    <div class="wrap relative md:grid md:grid-cols-[1fr_1.9fr] md:gap-[8%]">
      <h2 class="mb-6 md:mb-0">{background.heading}</h2>
      <div
        class="prose max-w-[68ch] text-base md:text-lg"
        set:html={background.html}
      />
    </div>
  </section>
  <section class="bg-silver py-10 md:py-16" id={expertise.id}>
    <div class="wrap">
      <div class="mb-8 md:grid md:grid-cols-[1fr_1.9fr] md:gap-[8%]">
        <h2 class="mb-5 md:mb-0">{expertise.heading}</h2>
        <div
          class="prose max-w-[65ch] text-base md:text-lg"
          set:html={expertise.html}
        />
      </div>
      <CapabilityMap
        entries={capabilities.map(([id, href]) => ({
          ...section(about, id),
          href,
        }))}
      />
      <div
        class="prose mt-6 text-base"
        id={expertiseLinks.id}
        set:html={groupLinkLists(expertiseLinks.html)}
      />
    </div>
  </section>
  <section class="wrap py-10 md:grid md:grid-cols-[1.45fr_1fr] md:gap-[8%] md:py-16">
    <div id={openSource.id}>
      <h2 class="mb-6">{openSource.heading}</h2>
      <div
        class="prose max-w-[65ch] text-base md:text-lg"
        set:html={openSource.html}
      />
    </div>
    <div
      class="mt-10 border-t border-line pt-8 md:mt-0 md:border-t-0 md:border-l md:pt-0 md:pl-8"
      id={company.id}
    >
      <h2 class="mb-6 text-[25px]">{company.heading}</h2>
      <div class="prose max-w-[55ch] text-base" set:html={company.html} />
    </div>
  </section>
</BaseLayout>
