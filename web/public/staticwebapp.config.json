{
  "routes": [
    {
      "route": "/default.aspx",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/robots",
      "redirect": "/projects/robots",
      "statusCode": 301
    },
    {
      "route": "/paypal",
      "redirect": "https://www.paypal.com/donate?hosted_button_id=GZ4W6SBU65EBQ",
      "statusCode": 301
    }
  ],
  "platform": {
    "apiRuntime": "dotnet-isolated:10.0"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), geolocation=(), microphone=()",
    "Cross-Origin-Opener-Policy": "same-origin"
  }
}
