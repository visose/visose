{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "Default": "Warning",
      "Host.Results": "Information",
      "Function.Contact": "Information"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "extensions": {
    "http": {
      "maxConcurrentRequests": 20,
      "maxOutstandingRequests": 40
    }
  }
}
